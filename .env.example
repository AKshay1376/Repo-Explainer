# GitHub API Authentication (Optional, but increases rate limit from 60 to 5,000 requests/hr)
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key (Required for repository explanations)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration (Optional, default is gpt-4o-mini with gpt-4o fallback)
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_QA_MODEL=gpt-4o-mini

# Deployment mode: local binds loopback; production requires explicit settings below.
APP_ENV=local
APP_HOST=127.0.0.1
APP_DEBUG=0
PORT=5000
# Production: set exact HTTPS origin(s), absolute persistent DATA_DIR,
# 32+ character APP_SECRET_KEY, and 16+ character APP_ADMIN_PASSWORD.
FRONTEND_ORIGINS=
DATA_DIR=
TEMP_DIR=
REPO_EXPLAINER_DB_PATH=
AUTH_MODE=disabled
APP_SECRET_KEY=
APP_ADMIN_PASSWORD=
SESSION_HOURS=12
ALLOW_LOCAL_FS_OPERATIONS=0
ALLOW_PATCH_APPLY=0
ALLOW_VALIDATOR_EXECUTION=0
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BYTES=1000000
MAX_IMPORT_BYTES=10000000
JOB_WORKERS=2
JOB_QUEUE_LIMIT=20
JOB_TIMEOUT_SECONDS=180
WEB_WORKERS=1
APP_VERSION=1.0.0
BUILD_COMMIT_SHA=
BUILD_TIMESTAMP=

# Server-Side Cache Configuration
CACHE_ENABLED=1
CACHE_TTL=3600
CACHE_MAXSIZE=100

# Rate Limiting Configuration
RATELIMIT_ENABLED=1
RATELIMIT_ANALYZE=10 per minute
RATELIMIT_DOWNLOAD=30 per minute
RATELIMIT_ASK=20 per minute
RATELIMIT_TRACE=30 per minute
RATELIMIT_IMPACT=30 per minute
RATELIMIT_SOURCE=60 per minute
RATELIMIT_HUMANIZE=30 per minute
RATELIMIT_HUMANIZE_AI=5 per minute
RATELIMIT_REFACTOR=20 per minute
RATELIMIT_REFACTOR_AI=5 per minute
RATELIMIT_VALIDATOR_RUN=5 per minute
RATELIMIT_STORAGE_URI=memory://
# Optional Phase 12 local patch checkout. Leave unset to keep patch writes disabled.
PATCH_LOCAL_ROOT=
HISTORY_LOCAL_ROOT=
# For a local folder without Git metadata, bind it to one analyzed owner/repo.
PATCH_REPOSITORY=
# Opt in to fixed Repo Explainer backend/frontend checks after a local patch apply.
